+ value PIXELFORMAT_BGRA8888 (0x16862004)
+ value PIXELFORMAT_RGB24 (0x17101803)

// Texture access
+ enum TextureAccess : i32 {
    static_ (0)
    streaming (1)
    target (2)
}

// Blend modes
+ value BLENDMODE_NONE (0x00000000)
+ value BLENDMODE_BLEND (0x00000001)
+ value BLENDMODE_ADD (0x00000002)
+ value BLENDMODE_MOD (0x00000004)
+ value BLENDMODE_MUL (0x00000008)
+ value BLENDMODE_BLEND_PREMULTIPLIED (0x00000010)

// Scale modes
+ enum ScaleMode : i32 {
    nearest (0)
    linear (1)
}

// Flip modes
+ enum FlipMode : i32 {
    none (0)
    horizontal (1)
    vertical (2)
}

// Logical presentation modes
+ enum LogicalPresentation : i32 {
    disabled (0)
    stretch (1)
    letterbox (2)
    overscan (3)
    integer_scale (4)
}

// System cursors
+ enum SystemCursor : i32 {
    default_ (0)
    text (1)
    wait (2)
    crosshair (3)
    progress (4)
    nwse_resize (5)
    nesw_resize (6)
    ew_resize (7)
    ns_resize (8)
    move (9)
    not_allowed (10)
    pointer (11)
}

